# Timberstone web admin panel — environment template
# Copy to .env.local and fill in:  cp .env.example .env.local
# NEXT_PUBLIC_* values are built into the browser bundle at build time
# (visible to users) — rebuild after changing them.

# Timberstone API base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# 1 = AES-encrypt requests/responses (is_crypto), 0 = base64 only
NEXT_PUBLIC_API_CRYPTO=0

# Must match CRYPTO_AES_KEY / CRYPTO_AES_IV in timberstone-api/.env
NEXT_PUBLIC_CRYPTO_AES_KEY=
NEXT_PUBLIC_CRYPTO_AES_IV=
